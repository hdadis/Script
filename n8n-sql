version: '3.8'

services:
  n8n:
    image: docker.n8n.io/n8nio/n8n:1.80.0 # Gunakan versi spesifik/stabil
    container_name: n8n
    ports:
      - "5678:5678"
    environment:
      - DB_TYPE=sqlite
      - TZ=Asia/Jakarta
      - GENERIC_TIMEZONE=Asia/Jakarta
      - NODE_ENV=production
      - N8N_HOST=192.168.18.9
      - N8N_PORT=5678
      - N8N_PROTOCOL=http
      - N8N_PUSH_BACKEND=websocket
      - N8N_PROXY_HOPS=1
      - N8N_SECURE_COOKIE=false
      - N8N_EDITOR_BASE_URL=http://192.168.18.9:5678/
      - N8N_HIDE_WATERMARK=true
      - WEBHOOK_URL=https://ai.balai.my.id/
      
      # --- OPTIMASI RESOURCE UNTUK HG680-P ---
      - N8N_RUNNERS_ENABLED=false          # Matikan runners terpisah untuk hemat RAM
      - EXECUTIONS_DATA_PRUNE=true          # Hapus log riwayat eksekusi lama
      - EXECUTIONS_DATA_MAX_AGE=168         # Simpan riwayat eksekusi maks 7 hari (dalam jam)
      - EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000 # Maksimal jumlah riwayat tersimpan
      - N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
    volumes:
      - ./n8n_data:/home/node/.n8n
    restart: unless-stopped
    deploy:
      resources:
        limits:
          memory: 770M                    # Batasi penggunaan RAM agar Armbian tidak freezing
