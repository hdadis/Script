monitor_thread = threading.Thread(target=monitor_new_devices, daemon=True)
monitor_thread.start()

def get_ip_details():
    try:
        url = "http://ip-api.com/json/"
        headers = {"User-Agent": "Mozilla/5.0"}
        response = requests.get(url, headers=headers, timeout=10)
        data = response.json()
        
        if data.get("status") == "success":
            return (
                "==== IP Detail Information ====\n"
                f"Country Name : {data.get('country', '')}\n"
                f"Country Code : {data.get('countryCode', '')}\n"
                f"Region       : {data.get('region', '')}\n"
                f"Region Name  : {data.get('regionName', '')}\n"
                f"City         : {data.get('city', '')}\n"
                f"Timezone     : {data.get('timezone', '')}\n"
                f"ISP          : {data.get('isp', '')}\n"
                f"AS           : {data.get('as', '')}\n"
                f"IP Address   : {data.get('query', '')}"
            )
        else:
            msg = data.get("message", "Gagal mendapatkan data IP")
            return f"API Error: {msg}"
            
    except requests.exceptions.RequestException as e:
        return f"Terjadi kesalahan jaringan: {e}"
    except Exception as e:
        return f"Gagal memproses response: {e}"

def get_cpu_temp():
    thermal_paths = [
        "/sys/class/thermal/thermal_zone0/temp",
        "/sys/class/hwmon/hwmon0/temp1_input",
        "/sys/class/hwmon/hwmon1/device/temp1_input"
    ]
    for path in thermal_paths:
        if os.path.exists(path):
            with open(path, "r") as f:
                temp_raw = int(f.read().strip())
                if temp_raw > 1000:
                    return f"{temp_raw / 1000:.1f}°C"
                return f"{temp_raw:.1f}°C"
    return "Tidak dapat membaca sensor suhu CPU"

def get_local_devices():
    device_list = scan_network()
    try:
        device_list.sort(key=lambda x: ipaddress.ip_address(x["ip"]))
    except Exception:
        pass

    formatted_devices = []
    for dev in device_list:
        formatted_devices.append(
            f"Nama : {dev['name']}\nIP   : {dev['ip']}\nMAC  : {dev['mac']}\n-----------------------"
        )
    
    if formatted_devices:
        return "==== Connected Devices ====\n" + "\n".join(formatted_devices)
    return "Tidak ada perangkat lain yang terdeteksi di jaringan lokal."

def get_uptime():
    uptime_seconds = time.time() - psutil.boot_time()
    days, remainder = divmod(uptime_seconds, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f"{int(days)}d {int(hours)}h {int(minutes)}m {int(seconds)}s"

