@bot.message_handler(commands=["restartservices", "RestartServices"])
def execute_restart_services(message):
    if str(message.chat.id) != MY_CHAT_ID:
        bot.reply_to(message, "⛔ Anda tidak memiliki akses untuk menjalankan perintah ini.")
        return
    
    command_text = "sudo service smbd restart && sudo service cups restart"
    bot.reply_to(message, "⚙️ Me-restart service `smbd` dan `cups`...", parse_mode="Markdown")
    
    try:
        output = subprocess.check_output(command_text, shell=True, stderr=subprocess.STDOUT, text=True, timeout=30)
        if not output.strip():
            output = "✅ Service smbd & cups berhasil direstart tanpa error!"
    except subprocess.TimeoutExpired:
        output = "❌ Error: Proses memakan waktu terlalu lama (timeout)."
    except subprocess.CalledProcessError as e:
        output = f"❌ Error (Exit Code {e.returncode}):\n{e.output}"
    except Exception as e:
        output = f"❌ Terjadi kesalahan: {e}"
    
    if len(output) > 4000:
        output = output[:4000] + "\n... (output dipotong karena terlalu panjang)"
        
    bot.send_message(message.chat.id, f"💻 *Hasil Restart Service:*\n```{output}```", parse_mode="Markdown")

bot.infinity_polling()
