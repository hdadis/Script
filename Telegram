@bot.message_handler(commands=["run", "Run"])
def execute_shell_command(message):
    if str(message.chat.id) != MY_CHAT_ID:
        bot.reply_to(message, "⛔ Anda tidak memiliki akses untuk menjalankan perintah ini.")
        return
    
    command_text = message.text.replace("/run", "").replace("/Run", "").strip()
    if not command_text:
        bot.reply_to(message, "⚠️ Masukkan perintah yang ingin dijalankan.\nContoh: `/run apt update`", parse_mode="Markdown")
        return
    
    if "systemctl" in command_text and "--no-pager" not in command_text:
        command_text += " --no-pager"
    
    bot.reply_to(message, f"⚙️ Menjalankan: `{command_text}`...", parse_mode="Markdown")
    
    try:
        output = subprocess.check_output(command_text, shell=True, stderr=subprocess.STDOUT, text=True, timeout=60)
        if not output.strip():
            output = "(Perintah berhasil dieksekusi tanpa output)"
    except subprocess.TimeoutExpired:
        output = "❌ Error: Proses memakan waktu terlalu lama (timeout)."
    except subprocess.CalledProcessError as e:
        output = f"❌ Error (Exit Code {e.returncode}):\n{e.output}"
    except Exception as e:
        output = f"❌ Terjadi kesalahan: {e}"
    
    if len(output) > 4000:
        output = output[:4000] + "\n... (output dipotong karena terlalu panjang)"
        
    bot.send_message(message.chat.id, f"💻 *Output Terminal:*\n```{output}```", parse_mode="Markdown")

