# ----------------------------- koordinat & geometri -----------------------------
def parse_koordinat(s):
    s = (s.strip().strip("'").strip('"')
         .replace("′", "'").replace("’", "'").replace("‘", "'")
         .replace("″", '"').replace("”", '"').replace("“", '"').replace("º", "°"))
    dms = re.findall(
        r"(\d+(?:[.,]\d+)?)\s*°\s*(\d+(?:[.,]\d+)?)\s*'\s*(\d+(?:[.,]\d+)?)\s*(?:\"|'')?\s*"
        r"(LU|LS|BT|BB|[NSEW])?", s, flags=re.I)
    if len(dms) >= 2:
        nilai = []
        for d, m, sec, h in dms[:2]:
            v = (float(d.replace(",", ".")) + float(m.replace(",", ".")) / 60
                 + float(sec.replace(",", ".")) / 3600)
            h = h.upper()
            if h in ("S", "W", "LS", "BB"):
                v = -v
            nilai.append((v, h))
        (a, ha), (b, hb) = nilai
        if ha in ("E", "W", "BT", "BB") or hb in ("N", "S", "LU", "LS"):
            a, b = b, a
        lat, lon = a, b
    else:
        bagian = [p for p in re.split(r"\s*;\s*|,\s+|\s+", s) if p]
        if len(bagian) < 2:
            raise ValueError("Format koordinat tidak dikenali")
        lat, lon = float(bagian[0].replace(",", ".")), float(bagian[1].replace(",", "."))
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        raise ValueError("Koordinat di luar jangkauan")
    return lat, lon


def to_dms(val, pos, neg):
    h = pos if val >= 0 else neg
    v = abs(val)
    d = int(v)
    m = int((v - d) * 60)
    sec = round(((v - d) * 60 - m) * 60, 1)
    if sec >= 60:
        sec -= 60
        m += 1
    if m >= 60:
        m -= 60
        d += 1
    return f"{d}°{m}'{sec:.1f}\"{h}"


def haversine_km(lat1, lon1, lat2, lon2):
    r = 6371.0088
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp, dl = p2 - p1, math.radians(lon2 - lon1)
    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * r * math.asin(math.sqrt(a))


def bearing_deg(lat1, lon1, lat2, lon2):
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    return (math.degrees(math.atan2(y, x)) + 360) % 360


def arah_detail(b):
    return ARAH8[int(round(b / 45.0)) % 8]


def sektor(b):
    if b >= 315 or b < 45:
        return "UTARA"
    if b < 135:
        return "TIMUR"
    if b < 225:
        return "SELATAN"
    return "BARAT"


def fmt_km(d):
    return f"{d:.2f}".replace(".", ",")


def fmt_r(r):
    return f"{r:g}".replace(".", ",")


def tanggal_id():
