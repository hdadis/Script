server:

    interface: 0.0.0.0

    access-control: 127.0.0.0 allow
    access-control: 192.168.0.0/24 allow
    access-control: ::1 allow
    access-control: 0.0.0.0/0 deny
    access-control: ::0/0 deny

    local-zone: "somebadsites.com." static
    local-zone: "somebadsites.com. IN A 127.0.0.1"
    local-data-ptr: "127.0.0.1 somebadsites.com."

Forward Zone:

    Name:"."

    forward-addr: 4.2.2.2
    forward-addr: 4.2.2.1
    forward-first: yes

